APP_HOST=0.0.0.0
APP_PORT=8081
CONSUMO_ML_IMAGE=luisalvarez3800/inventario-chatbot-backend-data:1.0

# Backend Java autorizado para CORS.
# Local: http://localhost:8080
# VPS: http://2.25.170.154:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
CORS_ALLOW_CREDENTIALS=false

# Base de datos PostgreSQL.
# Usa la BD existente del proyecto Docker inventario-ia.
POSTGRES_HOST=inventario-ia-db-1
POSTGRES_PORT=5432
POSTGRES_DB=inventario_chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
