APP_HOST=0.0.0.0
APP_PORT=8081

# Backend Java autorizado para CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080
CORS_ALLOW_CREDENTIALS=false

# Puedes usar DATABASE_URL o las variables POSTGRES_*.
# DATABASE_URL=postgresql+psycopg2://usuario:password@host:5432/inventario_chatbot
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=inventario_chatbot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
